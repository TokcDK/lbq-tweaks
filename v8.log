iables\x2C $gameSwitches) {\x0d\n  // Check for special state effects first (highest priority)\x0d\n  for (const stateId of valueTachieChangeState) {\x0d\n    if (gameActor.isStateAffected(stateId) && $dataStates[stateId].meta['FaceChange']) {\x0d\n      const faceChangeArr = $dataStates[stateId].meta['FaceChange'].split('\x2C');\x0d\n      return Number(faceChangeArr[getRandomIndex(faceChangeArr.length)]);\x0d\n    }\x0d\n  }\x0d\n\x0d\n  // Check for restraint state\x0d\n  if (gameActor.isStateAffected(63)) {\x0d\n    const constantVal50 = 50\x2C constantVal7 = 7;\x0d\n    if (gameActor.skillMasteryLevel(constantVal50) >= constantVal7) {\x0d\n      return RESTRAINED_FACE_OPTIONS[getRandomIndex(RESTRAINED_FACE_OPTIONS.length)];\x0d\n    } else {\x0d\n      return SIMPLE_FACE_OPTIONS[getRandomIndex(SIMPLE_FACE_OPTIONS.length)];\x0d\n    }\x0d\n  }\x0d\n\x0d\n  // Check for pregnancy state\x0d\n  if ((!$gameSwitches.value(143) && gameActor.isStateAffected(83)) || gameActor.isStateAffected(696)) {\x0d\n    const constantVal50 = 50\x2C constantVal7 = 7;\x0d\n    if (gameActor.skillMasteryLevel(constantVal50) >= constantVal7) {\x0d\n      // Do nothing\x2C return null to continue checks\x0d\n      return null;\x0d\n    } else {\x0d\n      return PREGNANCY_FACE_OPTIONS[getRandomIndex(PREGNANCY_FACE_OPTIONS.length)];\x0d\n    }\x0d\n  }\x0d\n\x0d\n  // Handle sweating effect\x0d\n  handleSweatEffectTachieSettei1(gameActor\x2C $gameVariables\x2C $gameSwitches);\x0d\n\x0d\n  return null;\x0d\n}\x0d\n\x0d\n// Function to get expression based on emotional arousal\x0d\nfunction getEmotionalExpressionTachieSettei1(gameActor\x2C $gameVariables\x2C $gameSwitches) {\x0d\n  // Check for states related to arousal\x2C etc.\x0d\n  if (EFFECT_STATE_IDS.some(stateId => gameActor.isStateAffected(stateId))) {\x0d\n    const intensity = $gameVariables.value($gameVariables.value(20) + 380)[1];\x0d\n\x0d\n    if (intensity >= 900) {\x0d\n      return HIGHEST_FACE_OPTIONS[getRandomIndex(HIGHEST_FACE_OPTIONS.length)];\x0d\n    } else if (intensity >= 700) {\x0d\n      return MODERATE_FACE_OPTIONS[getRandomIndex(MODERATE_FACE_OPTIONS.length)];\x0d\n    } else if (intensity >= 500) {\x0d\n      return MILD_FACE_OPTIONS[getRandomIndex(MILD_FACE_OPTIONS.length)];\x0d\n    } else if (intensity >= 300) {\x0d\n      return LOW_FACE_OPTIONS[getRandomIndex(LOW_FACE_OPTIONS.length)];\x0d\n    } else {\x0d\n      return SIMPLE_FACE_OPTIONS[getRandomIndex(SIMPLE_FACE_OPTIONS.length)];\x0d\n    }\x0d\n  }\x0d\n\x0d\n  return null;\x0d\n}\x0d\n\x0d\n// Function to handle exposure-based expressions\x0d\nfunction getExposureBasedExpressionTachieSettei1(gameActor\x2C $gameVariables\x2C $gameSwitches) {\x0d\n  handleExposureStateTachieSettei1(gameActor\x2C $gameVariables);\x0d\n\x0d\n  // Skip if special condition\x0d\n  if ($gameVariables.value(207) === 101 ||\x0d\n    ($gameVariables.value(207) >= 1 &&\x0d\n      $gameVariables.value(207) === $gameVariables.value($gameVariables.value(20) + 440)[41])) {\x0d\n    return null;\x0d\n  }\x0d\n\x0d\n  if (!$gameSwitches.value(206)) {\x0d\n    // Check exposure level against tolerance\x0d\n    if ($gameVariables.value($gameVariables.value(20) + 380)[4] <\x0d\n      $gameVariables.value($gameVariables.value(20) + 380)[5]) {\x0d\n      $gameSwitches.setValue(100\x2C true);\x0d\n      return LOW_FACE_OPTIONS[getRandomIndex(LOW_FACE_OPTIONS.length)];\x0d\n    }\x0d\n\x0d\n    // Check for low clothing value\x0d\n    if ($gameVariables.value($gameVariables.value(20) + 380)[4] <= 49) {\x0d\n      const tempClothesValue = $gameVariables.value($gameVariables.value(20) + 380)[1];\x0d\n      const masteryLevel = gameActor.skillMasteryLevel(55);\x0d\n\x0d\n      $gameSwitches.setValue(100\x2C true);\x0d\n      if (tempClothesValue >= 500 && masteryLevel >= 4) {\x0d\n        return HIGHER_FACE_OPTIONS[getRandomIndex(HIGHER_FACE_OPTIONS.length)];\x0d\n      }\x0d\n    }\x0d\n  }\x0d\n\x0d\n  return null;\x0d\n}\x0d\n\x0d\n// Function to get default expressions based on situation\x0d\nfunction getDefaultExpressionTachieSettei1($gameVariables\x2C $gameSwitches) {\x0d\n  if ($gameSwitches.value(30)) { // In battle\x0d\n    return damageFaceExpressionsMap[$gameVariables.value(276)] || 4;\x0d\n  } else if ($gameSwitches.value(201) || $gameSwitches.value(239)) { // Excited\x0d\n    return excitedFaceExpressions[getRandomIndex(excitedFaceExpressions.length)];\x0d\n  } else { // Normal\x0d\n    return baseFaceExpressions[getRandomIndex(baseFaceExpressions.length)];\x0d\n  }\x0d\n}\x0d\n\x0d\n// Helper function to handle exposure state\x0d\nfunction handleExposureStateTachieSettei1(gameActor\x2C $gameVariables) {\x0d\n  if (gameActor.isStateAffected(70)) {\x0d\n    const currentClothesId = $gameVariables.value($gameVariables.value(20) + 440)[0];\x0d\n    const exposureValue = $gameVariables.value($gameVariables.value(20) + 380)[4];\x0d\n    if (currentClothesId >= 1 && exposureValue <= 9) {\x0d\n      $gameVariables.value($gameVariables.value(20) + 440)[0] = 0;\x0d\n    }\x0d\n  }\x0d\n}\x0d\n\x0d\n// Helper function to handle sweat effect\x0d\nfunction handleSweatEffectTachieSettei1(gameActor\x2C $gameVariables\x2C $gameSwitches) {\x0d\n  if (gameActor.isStateAffected(693)) {\x0d\n    $gameSwitches.setValue(100\x2C false);\x0d\n  }\x0d\n\x0d\n  if ($gameSwitches.value(100)) {\x0d\n    const constantVal50 = 50\x2C constantVal5 = 5;\x0d\n    if (gameActor.skillMasteryLevel(constantVal50) >= constantVal5) {\x0d\n      $gameVariables.setValue(TACHIE_SETTEI1_BASE_VAR_ID + 13\x2C 2);\x0d\n    } else {\x0d\n      $gameVariables.setValue(TACHIE_SETTEI1_BASE_VAR_ID + 13\x2C 1);\x0d\n    }\x0d\n  }\x0d\n\x0d\n  // Reset switch after processing\x0d\n  $gameSwitches.setValue(100\x2C false);\x0d\n}\x0d\n//#endregion\x0d\n\x0d\n//\u7834\u640d\u6642\u7b2c\u4e00\u6bb5\u968e\x0d\nclothes_hason1 = function (array\x2C id1) {\x0d\n\x0d\n  const gameVar20 = $gameVariables.value(20);\x0d\n  if (id1 >= 1) {\x0d\n    for (let i = 1; i <= 40; i++) {\x0d\n      $gameVariables.setValue(i + 460\x2C $gameVariables.value(gameVar20 + 440)[i]);\x0d\n    };\x0d\n  };\x0d\n  $gameVariables.setValue(243\x2C 0);\x0d\n  $gameVariables.setValue(244\x2C 0);\x0d\n  const menuText1 = array[getRandomIndex(array.length)];\x0d\n  if (menuText1 == 1) return;\x0d\n  if ($gameVariables.value(460 + menuText1) < 1) return;\x0d\n\x0d\n  const itemCount = $dataItems.length;\x0d\n  for (let i = 1205; i < itemCount; i++) {\x0d\n    const item = $dataItems[i];\x0d\n    if (menuText1 != Number(item.meta['ClothSwitch'])) continue;\x0d\n    if ($gameVariables.value(menuText1 + 460) != Number(item.meta['ClothAllocationNumber'])) continue;\x0d\n\x0d\n    const itemEICSwitchNum = Number(item.meta['EICSwitch']);\x0d\n    if (itemEICSwitchNum != 200 && gameVar20 != itemEICSwitchNum - 180 && gameVar20 != itemEICSwitchNum - 380) continue;\x0d\n\x0d\n    $gameVariables.setValue(243\x2C item.name);\x0d\n    $gameVariables.setValue(244\x2C i);\x0d\n    $gameSwitches.setValue(143\x2C true);\x0d\n    if (item.meta['ClothBreakage']) {\x0d\n      const itemClothBreakageNum = Number(item.meta['ClothBreakage']);\x0d\n      if (itemClothBreakageNum != $gameVariables.value(460 + val1)) {\x0d\n        $gameVariables.setValue(460 + val1\x2C itemClothBreakageNum);\x0d\n      }\x0d\n    } else {\x0d\n      $gameVariables.setValue(460 + val1\x2C 0);\x0d\n    }\x0d\n    if (id1 >= 1) {\x0d\n      $gameVariables.setValue(460 + val1\x2C 0);\x0d\n    }\x0d\n    //\u8863\u88c5\u60c5\u5831\u3092\u66f4\u65b0\x0d\n    for (let i = 1; i <= 40; i++) {\x0d\n      $gameVariables.value(gameVar20 + 440)[i] = $gameVariables.value(i + 460)\x0d\n    };\x0d\n    break;\x0d\n  }\x0d\n};\x0d\n\x0d\n//\u7834\u640d\u6642\u5207\u308c\u7aefColorHue\u7528\x0d\nclothes_hason2 = function (id1\x2C id2) {\x0d\n\x0d\n  const item = $dataItems[$gameVariables.value(244)];\x0d\n  const itemClothSwitch = item.meta['ClothSwitch'];\x0d\n  if (!itemClothSwitch) return;\x0d\n\x0d\n  c
bug(`runTachieLoop: For part ${j}\x2C current value = ${currVal}`);\x0d\n      return currVal;\x0d\n    });\x0d\n  }\x0d\n\x0d\n  // Check if we need to change the character's standing image\x0d\n  if (tachieIndex !== -1) {\x0d\n    // Update character data if different from current\x0d\n    const currentChar = tachieIndex < picData.length ? picData[tachieIndex].char : null;\x0d\n    console.debug(`tachie_naibusyori2: currentChar = ${currentChar}\x2C desired = ${actorCharName}`);\x0d\n\x0d\n    if (currentChar !== actorCharName && actorCharName in charList && tachieIndex < picData.length) {\x0d\n      console.debug(`tachie_naibusyori2: Updating picData at index ${tachieIndex} with new char ${actorCharName}`);\x0d\n      picData[tachieIndex].char = actorCharName;\x0d\n      picData[tachieIndex].bitmap = [];\x0d\n      tachieData.preloadBitmap(tachieIndex);\x0d\n    }\x0d\n\x0d\n    // Show the standing picture if it exists\x0d\n    if (tachieIndex < picData.length && picData[tachieIndex].char) {\x0d\n      const pictureId = picData[tachieIndex].picNum;\x0d\n      const name = "TKMtachie_" + picData[tachieIndex].char + "_";\x0d\n      const x = picData[tachieIndex].x;\x0d\n      const y = picData[tachieIndex].y;\x0d\n      console.debug(`tachie_naibusyori2: Showing picture with picNum ${pictureId}\x2C name ${name}\x2C at (${x}\x2C ${y})`);\x0d\n      $gameScreen.showPicture(pictureId\x2C name\x2C 0\x2C x\x2C y\x2C 85\x2C 85\x2C 0\x2C 0);\x0d\n    } else {\x0d\n      console.debug("tachie_naibusyori2: Picture data not found or character not set.");\x0d\n    }\x0d\n  } else {\x0d\n    console.debug("tachie_naibusyori2: tachieIndex is -1\x2C skipping standing picture display.");\x0d\n  }\x0d\n};\x0d\n\x0d\n// Helper function to execute tachie_naibusyori1 in a loop\x2C from tachie_naibusyori2\x0d\nfunction runTachieLoop(start\x2C end\x2C getThirdArg\x2C condition = () => true) {\x0d\n  for (let j = start; j <= end; j++) {\x0d\n    if (condition(j)) {\x0d\n      const args = [\x0d\n        String($gameVariables.value(118))\x2C\x0d\n        String(j)\x2C\x0d\n        String(getThirdArg(j))\x0d\n      ];\x0d\n      tachie_naibusyori1(args);\x0d\n    }\x0d\n  }\x0d\n}\x0d\n\x0d\n//\u2606\u2606\u7acb\u3061\u7d75\u5185\u90e8\u51e6\u7406CP\u4e00\u3064\u305a\u3064\x0d\n/**\x0d\n* Handles internal processing for character parts in the tachie (standing image) system.\x0d\n* Updates a specific part of a character's standing image and manages its bitmap resources.\x0d\n* @param {Array} args - [characterName\x2C partName\x2C partNumber]\x0d\n*/\x0d\ntachie_naibusyori1 = function (args) {\x0d\n  // Extract parameters for clarity\x0d\n  const characterName = args[0];\x0d\n  const partName = args[1];\x0d\n  const partNumber = parseInt(args[2]\x2C 10) || 0;\x0d\n\x0d\n  // Early exit if character doesn't exist\x0d\n  if (!(characterName in $TKMvar.tachie.CharList)) {\x0d\n    return;\x0d\n  }\x0d\n\x0d\n  // Cache frequently accessed objects\x0d\n  const tachie = $TKMvar.tachie;\x0d\n  const charList = tachie.CharList;\x0d\n  const partsNameArr = tachie.partsNameArr;\x0d\n  const picData = tachie.PicData;\x0d\n\x0d\n  // Find the layer corresponding to this part name\x0d\n  const layerNum = partsNameArr.indexOf(partName);\x0d\n  if (layerNum === -1) {\x0d\n    return; // Part name not found in layers\x0d\n  }\x0d\n\x0d\n  // Skip if the part is already set to the requested number\x0d\n  if (charList[characterName][layerNum] === partNumber) {\x0d\n    return;\x0d\n  }\x0d\n\x0d\n  // Update the character part in the list\x0d\n  charList[characterName][layerNum] = partNumber;\x0d\n\x0d\n  // Update the bitmap cache for each picture using this character\x0d\n  const picCount = picData.length;\x0d\n  for (let i = 0; i < picCount; i++) {\x0d\n    if (picData[i].char !== characterName) continue;\x0d\n\x0d\n    const pic = picData[i];\x0d\n\x0d\n    // Initialize bitmap array if needed\x0d\n    if (!pic.bitmap) {\x0d\n      tachie.preloadBitmap(i);\x0d\n  
5 - val5\x2C 0\x2C 0\x2C 60);\x0d\n    }\x0d\n    valueCountSet1 += 1;\x0d\n  }\x0d\n  if (item.meta['ColorHue']) {\x0d\n    //let value13 = Number(item.meta['ColorHue']);\x0d\n    //$gameScreen.showPicture_hue(valueCountSet1\x2C'actor' + value6 + '_' + 42 + '_' + value7\x2Cvalue13\x2C1\x2Cvalue2\x2Cvalue3\x2Cvalue4\x2Cvalue5\x2C255\x2C0);\x0d\n    $gameScreen.showPicture(valueCountSet1\x2C "/img/tachies/" + 'actor' + val6 + '_' + 42 + '_' + val7\x2C 1\x2C val2\x2C val3\x2C val4\x2C val5\x2C 255\x2C 0);\x0d\n  } else {\x0d\n    $gameScreen.showPicture(valueCountSet1\x2C "/img/tachies/" + 'actor' + val6 + '_' + 42 + '_' + val7\x2C 1\x2C val2\x2C val3\x2C val4\x2C val5\x2C 255\x2C 0);\x0d\n  }\x0d\n  if (id2 == 1) {\x0d\n    $gameScreen.movePicture(valueCountSet1\x2C 1\x2C picId2\x2C picId3\x2C picId4\x2C picId5\x2C 0\x2C 0\x2C 60);\x0d\n    picture_fade1(valueCountSet1\x2C "fadeOut"\x2C 'Hscene005'\x2C 60\x2C 5);\x0d\n  }\x0d\n  else if (id2 == 0) {\x0d\n    $gameScreen.movePicture(valueCountSet1\x2C 1\x2C val2\x2C val3 + val3\x2C val4\x2C val5\x2C 0\x2C 0\x2C 60);\x0d\n  }\x0d\n  valueCountSet1 += 1;\x0d\n};\x0d\n\x0d\n//\u7740\u305b\u66ff\u3048\u6642\u7d71\u5408\u8863\u88c5\u4ed6\u51e6\u7406\x0d\nclothes_change1 = function () {\x0d\n\x0d\n  const id = 1;\x0d\n  const menuText1 = 380 + $gameVariables.value(20);\x0d\n  const menuText2 = 400;\x0d\n  const itemsCount = $dataItems.length;\x0d\n\x0d\n  valueRandomSet = Array(101).fill(0);\x0d\n\x0d\n  let j = 1;\x0d\n  for (let i = 1; i < itemsCount; i++) {\x0d\n    const item = $dataItems[i];\x0d\n    if ($gameParty.hasItem(item)) {\x0d\n      const menuText3 = Number(item.meta['EICSwitch']);\x0d\n      if (menuText3 == menuText1 || menuText3 == menuText2) {\x0d\n        const choiceParams = {\x0d\n          text: item.name\x2C\x0d\n          value: i\x0d\n        };\x0d\n        $gameSystem.addCustomChoice(id\x2C choiceParams);\x0d\n        valueRandomSet[j] = i;\x0d\n        j++;\x0d\n      }\x0d\n    }\x0d\n  }\x0d\n\x0d\n};\x0d\n\x0d\n//\u7740\u305b\u66ff\u3048\u6642\u5358\u54c1\u76ee\u51e6\u7406\x0d\nclothes_change2 = function () {\x0d\n\x0d\n  const id = 2;\x0d\n  const actorId = $gameVariables.value(20);\x0d\n  const menuText1 = 380 + actorId;\x0d\n  const menuText2 = 400;\x0d\n  const itemsCount = $dataItems.length;\x0d\n  const item19 = $dataItems[$gameVariables.value(19)];\x0d\n\x0d\n  $gameScreen.showPicture(100\x2C '/img/tachies/actor' + actorId + '_5_99'\x2C 1\x2C 1200\x2C 550\x2C 20\x2C 20\x2C 200\x2C 0);\x0d\n  valueRandomSet = Array(201).fill(0);\x0d\n\x0d\n  let j = 1;\x0d\n  for (let i = 1; i < itemsCount; i++) {\x0d\n    const item = $dataItems[i];\x0d\n    if ($gameParty.hasItem(item) &&\x0d\n      item19.meta['subCategory'] == item.meta['subCategory']) {\x0d\n      const itemEICSwitchNum = Number(item.meta['EICSwitch']);\x0d\n      if (itemEICSwitchNum == menuText1 || itemEICSwitchNum == menuText2 || itemEICSwitchNum == menuText1 - 200 || itemEICSwitchNum == menuText2 - 200) {\x0d\n        const choiceParams = { text: item.name\x2C value: i };\x0d\n        $gameSystem.addCustomChoice(id\x2C choiceParams);\x0d\n        if (!item.meta['TotalCloth']) {\x0d\n          if (Number(item.meta['ClothAllocationNumber']) >= 1) {\x0d\n            $gameScreen.showPicture(j + 100\x2C "/img/tachies/" + 'actor' + actorId + '_' + Number(item.meta['ClothSwitch']) + '_' + Number(item.meta['ClothAllocationNumber'])\x2C 1\x2C 1200\x2C 550\x2C 20\x2C 20\x2C 0\x2C 0);\x0d\n            $gameMessage.setSelectPictureId(j - 1\x2C j + 100);\x0d\n          };\x0d\n        };\x0d\n        valueRandomSet[j] = i;\x0d\n        j++;\x0d\n      }\x0d\n    }\x0d\n  }\x0d\n\x0d\n};\x0d\n\x0d\n//\u8863\u88c5\u53d6\u5f97\x0d\nclothes_get = function (id\x2C val1\x2C val2) {\x0d\n\x0d\n  $gameVariables.setValue(20\x2C id); // replaced $gameVariables.value(20) below by id\x2C get id is much faster than get variable value\x0d\n  const items = $dataItems;\x0d\n  const itemsCount = items.length;\x0d\n  f
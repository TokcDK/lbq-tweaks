alX\x2C originalY\x2C originalScaleX\x2C originalScaleY\x2C originalOpacity\x2C 0\x2C fadeDelayDuration);\x0d\n      $gameScreen.movePicture(sourcePicId\x2C originalOrigin\x2C originalX\x2C originalY\x2C originalScaleX\x2C originalScaleY\x2C 0\x2C 0\x2C primaryMoveDuration);\x0d\n    }\x0d\n\x0d\n    // Additional blessing effect if switch 126 is enabled\x0d\n    if ($gameSwitches.value(126)) {\x0d\n      tachie_bless(targetPicId\x2C 0);\x0d\n    }\x0d\n\x0d\n    // Update event graphics if variable 292 holds a valid event ID for the actor\x0d\n    const dynamicallyGeneratedEventIds = $gameVariables.value(292); // Use the dynamically generated ID array for events\x0d\n    const actorId = $gameVariables.value(20);\x0d\n    if (dynamicallyGeneratedEventIds !== 0 && dynamicallyGeneratedEventIds[actorId] >= 1) {\x0d\n      const event = $gameMap.event(dynamicallyGeneratedEventIds[actorId]);\x0d\n      const actor = $gameActors.actor(actorId);\x0d\n      event.setImage(actor.characterName()\x2C actor.characterIndex());\x0d\n    }\x0d\n  }\x0d\n}\x0d\n\x0d\nfunction calculateScaleAndPositionTachieDousa(actorParameter\x2C targetPicId\x2C expressionCode) {\x0d\n  const isScaled = $gameSwitches.value(126);\x0d\n  let picY\x2C picScaleX\x2C picScaleY;\x0d\n\x0d\n  // Check if actorParameter is numeric (including 0)\x0d\n  if ((typeof actorParameter === 'number' || (!isNaN(actorParameter) && actorParameter !== null)) && actorParameter >= 0) {\x0d\n    $gameVariables.setValue(20\x2C actorParameter);\x0d\n    $gameVariables.setValue(300\x2C targetPicId);\x0d\n    $gameVariables.setValue(151\x2C expressionCode); // Set expression code\x0d\n\x0d\n    // Use general configuration for numeric actorParameter\x0d\n    const { scale\x2C y } = scaleConfigGeneral1TachieDousaMap[isScaled];\x0d\n    picScaleY = picScaleX = scale;\x0d\n    picY = y;\x0d\n  } else {\x0d\n    // Use textual configuration if actorParameter is not numeric\x0d\n    const { scale\x2C y } = scaleConfigGeneral2Tach
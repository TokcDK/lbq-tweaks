eter\x2C showCostumeId\x2C changeCostumeId\x2C changeCostumeParam\x2C targetPicId\x2C sourcePicId\x2C expressionCode) {\x0d\n  // Determine move durations based on costume change flag\x0d\n  let primaryMoveDuration = changeCostumeId === 0 ? 60 : changeCostumeId + changeCostumeId;\x0d\n  let fadeDelayDuration = changeCostumeId === 0 ? 30 : changeCostumeId;\x0d\n\x0d\n  // Cache source picture values for smooth transition\x0d\n  let sourcePic = $gameScreen.picture(sourcePicId);\x0d\n  if (sourcePic) {\x0d\n    let originalOrigin = sourcePic.origin();\x0d\n    let originalX = sourcePic.x();\x0d\n    let originalY = sourcePic.y();\x0d\n    let originalScaleX = sourcePic.scaleX();\x0d\n    let originalScaleY = sourcePic.scaleY();\x0d\n    let originalOpacity = sourcePic.opacity();\x0d\n\x0d\n    // If temporary values were set by previous operations\x2C use them instead\x0d\n    if (valueTacieSet[0] >= 1) {\x0d\n      originalOrigin = valueTacieSet[0];\x0d\n      originalX = valueTacieSet[1];\x0d\n      originalY = valueTacieSet[2];\x0d\n      originalScaleX = valueTacieSet[3];\x0d\n      originalScaleY = valueTacieSet[4];\x0d\n      originalOpacity = valueTacieSet[5];\x0d\n      valueTacieSet = [0\x2C 0\x2C 0\x2C 0\x2C 0\x2C 0];\x0d\n    }\x0d\n\x0d\n    // For numeric actorParameter\x2C perform costume change or setup routine\x0d\n    if (actorParameter >= 1) {\x0d\n      if (showCostumeId >= 1) {\x0d\n        kisekae_tyokusetusitei(showCostumeId\x2C expressionCode);\x0d\n      } else {\x0d\n        tachie_settei2();\x0d\n      }\x0d\n      const targetPic = $gameScreen.picture(targetPicId);\x0d\n      targetPic._origin = originalOrigin;\x0d\n      targetPic._x = originalX;\x0d\n      targetPic._y = originalY;\x0d\n      targetPic._scaleX = originalScaleX;\x0d\n      targetPic._scaleY = originalScaleY;\x0d\n      targetPic._opacity = 0;\x0d\n    } else {\x0d\n      // Otherwise\x2C erase target picture and then show a new picture\x0d\n      let targetPic = $gameScreen.
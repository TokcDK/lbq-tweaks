script-source,3,,\ufeff/*\x0d\ntachie_kaiwastart(false\x2Cfalse\x2C3\x2C1);\x0d\n//\u6025\u304e\x2C\u62e1\u5927\x2C\u53f3\u4eba\u6570\x2C\u5de6\u4eba\u6570\x0d\n\x0d\n\u4e00\u6642\u30b9\u30c6\u30fc\u30c8\x0d\n694\u611b\u6db2\u3001695\u6c57\u3001696\u30dc\u30c6\u3001\x0d\n697\u4e2d\u3060\u3057\u3001698\u9854\u5c04\u7cbe\u3001699\u3076\u3063\u304b\u3051\x0d\n\x0d\n//0\u8863\u88c5\u5909\u66f4\u5373\u6642\u3002id2\u304c\uff71\uff78\uff80ID\u304b\u7acb\u3061\u7d75\u540d\x2Cid3\u304c\u8868\u60c5\x2Cid4\u304c\u65b0\uff8b\uff9f\uff78ID\x2Cid5\u304c\u65e7\uff8b\uff9f\uff78ID\x2Cid6\u304c\u8863\u88c5\u5909\u66f4\u306a\u3057\u306e\u5834\u5408\u306f0\x0d\ntachie_dousa(0\x2C1\x2C2\x2C12\x2C13\x2C1205\x2C0\x2C0\x2C0);\x0d\n//1\u767b\u5834\x2C\uff71\uff78\uff80\uff70ID\u304b\u7acb\u3061\u7d75\u76f4\u63a5\u6307\u5b9a\x2C\u8868\u60c5\u6307\u5b9a\x2C\uff8b\uff9f\uff78ID\x2C0\u4e2d1\u53f32\u5de6\x2C\u900f\u660e\u5ea6\x2C0\x2C0\x2C0\x0d\ntachie_dousa(1\x2C1\x2C1\x2C13\x2C0\x2C255\x2C0\x2C0\x2C0);\x0d\n//2\u8863\u88c5\u8868\u60c5\u5909\u66f4\x2C\uff71\uff78\uff80\uff70ID\u304b\u7acb\u3061\u7d75\u76f4\u63a5\u6307\u5b9a\x2C\u8868\u60c5\u6307\u5b9a\x2C\uff8b\uff9f\uff78ID\x2C0\u53f31\u5de6\x2C\u900f\u660e\u5ea6\x2C\u8863\u88c5\uff71\uff72\uff83\uff91ID\x2C0\x2C0\x0d\ntachie_dousa(2\x2C1\x2C1\x2C14\x2C0\x2C255\x2C1119\x2C0\x2C0);\x0d\nthis.wait(3);\x0d\n//3\u7acb\u3061\u7d75\u66f4\u65b0\x2C0\x2C0\x2C\uff8b\uff9f\uff78ID\x2C0\x2C0\x2C0\x2C0\x2C0\u3002\u4e0d\u8981\u306b\u306a\u3063\u305f\x0d\ntachie_dousa(3\x2C0\x2C0\x2C13\x2C0\x2C0\x2C0\x2C0\x2C0);\x0d\nthis.wait(60);\x0d\n//4\u884c\u52d5\x2C0\x2C0\x2C\uff8b\uff9f\uff78ID\x2C0\x2C0\x2C2\u53cd\u8ee23\u79fb\u52d54\u9000\u51fa5\u5012\u308c\u308b6\u653b\u6483\x2C\u79fb\u52d5\u3068\u9000\u51fax\x2C0\u3002\u30e1\u30c3\u30bb\u30fc\u30b8\u306a\u3044\u5834\u5408\u30a6\u30a7\u30a4\u30c820\u5165\u308c\u308b\x0d\ntachie_dousa(4\x2C0\x2C0\x2C14\x2C0\x2C0\x2C2\x2C0\x2C0);//\u53cd\u8ee2\x0d\ntachie_dousa(4\x2C0\x2C0\x2C14\x2C0\x2C0\x2C3\x2C100\x2C0);//\u79fb\u52d5(x+100)\x0d\n//5\u30a2\u30cb\u30e1\x2C0\x2C0\x2C\uff8b\uff9f\uff78ID\x2C0\x2C0\x2C\uff71\uff86\uff92ID\x2C0\x2C//\u30a2\u30cb\u30e1\u3068\u7acb\u3061\u7d75\u8272\u8abf\u5909\u66f4id9y\u5ea7\u6a19\u306b+\x0d\ntachie_dousa(5\x2C0\x2C0\x2C15\x2C0\x2C0\x2C196\x2C0\x2C250);\x0d\n//\uff8b\uff9f\uff78ID\x2C0\u5b9f\u884c1\u7d42\u4e86\x2C1\u30d0\u30d5par2\u30c7\u30d0\u30d5par\x0d\ntachie_partDirectSet(13\x2C1\x2C1);\x0d\ntachie_partDirectSet(13\x2C0\x2C1);\x0d\n\x0d\nvalueCountSet1 = 101;\x0d\ntachie_clothesHason(1\x2C22\x2C13\x2C1\x2C1);//\uff71\uff78\uff80\uff70ID\x2C\u7834\u640d\u90e8\u4f4d\x2C\uff8b\uff9f\uff78ID\x2C1\u3067\u5168\u640d0\u3067\u7834\u640d\u3001101\u306f\u7834\u640dCG\u8868\u793a\uff8b\uff9f\uff78ID\u59cb\u70b9\x0d\ntachie_clothesHason(1\x2C22\x2C13\x2C1\x2C0);//id5\u304c1\u3067\u7834\u640d\u30010\u3067\u8131\u8863\x0d\ntachie_dousa(0\x2C1\x2C10\x2C12\x2C13\x2C0\x2C0\x2C0\x2C0);\x0d\nthis.wait(Math.randomInt(10));\x0d\n$gameScreen.erasePicture(13);//\u7acb\u3061\u7d75\u5207\u308a\u66ff\u3048\u5f8c\u3001\u6b21\u306e\u52d5\u4f5c\u3067\u65e7\u30d4\u30af\u6d88\u53bb\x0d\n\x0d\n\u7279\u6b8a\u7acb\u3061\u7d75\u304b\u3089\u306e\u901a\u5e38\u7acb\u3061\u7d75\u5909\u66f4\u6642\x0d\n$gameVariables.setValue(164\x2C0);//x\u8ef8\u305a\u3089\u3057\x0d\ntachie_dousa(1\x2C1\x2C1\x2C13\x2C0\x2C255\x2C0\x2C0\x2C0);\x0d\nthis.wait(60);\x0d\n\u6587\u7ae0\u306e\u8868\u793a\u3092\u3057\u3066\u304b\u3089\u8863\u88c5\u5909\u66f4\u30b9\u30af\u30ea\u30d7\u30c8\x0d\n\u30d5\u30a7\u30fc\u30c9\u30a2\u30a6\u30c8\x0d\nvar actor = $gameActors.actor($gameVariables.value(20));\x0d\nactor.addState(23);\x0d\ntachie_syoukyo1(getPreviousTachiePicId());\x0d\n//$gameVariables.setValue(20\x2C1);\x0d\nkisekae_tyokusetusitei(1324\x2C23);\x0d\ntachie_syoukyo1(getPreviousTachiePicId());\x0d\nthis.wait(60);//\u3053\u3053\u3067\u30b9\u30af\u30ea\u30d7\u30c8\u5207\u308b\x0d\n$gameSwitches.setValue(42\x2Ctrue);\x0d\ntachie_hyouji1($gameVariables.value(20));\x0d\nvar args = new Array(String(getPreviousTachiePicId())\x2C'71'\x2C'2'\x2C'ON')\x0d\nthis.pluginCommand("P_CALL_CE"\x2C args);\x0d\n\u30d5\u30a7\u30fc\u30c9\u30a4\u30f3\x0d\n\x0d\n */\x0d\n\x0d\n/*:\x0d\n* @plugindesc \u3053\u306e\u30b2\u30fc\u30e0\u5c02\u7528\u30d7\u30e9\u30b0\u30a4\u30f3\x0d\n* @author \u4f5c\u8005\u540d\x0d\n* @help \u30b2\u30fc\u30e0\u5c02\u7528\u306b\u4f5c\u6210\u3055\u308c\u305f\u521d\u671f\u8aad\u307f\u8fbc\u307f\u7528\u30d7\u30e9\u30b0\u30a4\u30f3\x0d\n*/\x0d\n\x0d\n//(function() {\x0d\n\x0d\n//\u7acb\u3061\u7d75\u4f1a\u8a71\u8863\u88c5\u3092\u5b9f\u969b\u306e\u7acb\u3061\u7d75\u306b\u53cd\u6620\u3055\u305b\u308b\u3002\u56de\u60f3\u6642\u306f\u81ea\u52d5\u3067off\x0d\ntachie_clothReflect = function (actorId) {\x0d\n\x0d\n  if (!$gameSwitches.value(29)) {\x0d\n    const targetClothingData = $gameVariables.value(actorId + 540);\x0d\n    const sourceClothingData = $gameVariables.value(actorId + 440);\x0d\n    for (var i = 0; i <= 42; i++) {\x0d\n      targetClothingData[i] = sourceClothingData[i];\x0d\n    }\x0d\n  }\x0d\n\x0d\n};\x0d\n\x0d\n//\u7acb\u3061\u7d75\u30e0\u30fc\u30d6\u3002\x0d\npicTachie_move1 = function (picId\x2C offsetX\x2C offsetY\x2C scaleOffsetX\x2C scaleOffsetY\x2C targetOpacity\x2C moveDuration) {\x0d\n  if (typeof picId !== 'number' || picId < 1) {\x0d\n    console.warn("Invalid picId:"\x2C picId);\x0d\n    return;\x0d\n  }\x0d\n  const picture = $gameScreen.picture(picId);\x0d\n  if (picture) {\x0d\n    const newX = picture.x() + (Number(offsetX) || 0);\x0d\n    const newY = picture.y() + (Number(offsetY) || 0);\x0d\n    const newScaleX = picture.scaleX() + (Number(scaleOffsetX) || 0);\x0d\n    const newScaleY = picture.scaleY() + (Number(scaleOffsetY) || 0);\x0d\n    const pictureOrigin = picture.origin();\x0d\n    $gameScreen.movePicture(picId\x2C pictureOrigin\x2C newX\x2C newY\x2C newScaleX\x2C newScaleY\x2C Number(targetOpacity) || 255\x2C 0\x2C Number(moveDuration) || 60);\x0d\n  }\x0d\n};\x0d\n\x0d\n//\u8863\u88c5\u72b6\u614b\u3067\u30b9\u30a4\u30c3\u30c1\u30aa\u30f3\u30aa\u30d5.<EvStartCloth:1\x2C1>\u3068\u4f75\u7528\x0d\ntachie_switchOnOff = function (id) {\x0d\n\x0d\n  if (id == 1) {\x0d\n    $gameSwitches.setValue(601\x2C $gameVariables.value(440 + id)[20] == 0);\x0d\n  }\x0d\n\x0d\n};\x0d\n\x0d\n//\u7acb\u3061\u7d75\u6f14\u51fa\u30af\u30ea\u30a2\u3082\u30021\u5b9f\u884c0\u7d42\u4e86\x0d\ntachie_partDirectSet = function(pictureId\x2C enableFlag\x2C particleType) {\x0d\n  // Early return if particleType is not valid (1 or 2)\x0d\n  if (particleType !== 1 && particleType !== 2) return;\x0d\n  \x0d\n  // Cache particle name for better performance\x0d\n  const particleName = particleType === 1 ? 'actor_particleLight' : 'enemy_particleDark';\x0d\n  \x0d\n  if (enableFlag === 1) {\x0d\n    // Create sound effect configuration object only once\x0d\n    const soundConfig = {\x0d\n      name: particleType === 1 ? "Up1" : "Down4"\x2C\x0d\n      volume: 90\x2C\x0d\n      pitch: particleType === 1 ? 110 : 90\x2C\x0d\n      pan: 0\x0d\n    };\x0d\n    \x0d\n    // Flash with appropriate color\x0d\n    $gameScreen.startFlash(\x0d\n      particleType === 1 ? [255\x2C 255\x2C 255\x2C 200] : [0\x2C 0\x2C 0\x2C 200]\x2C \x0d\n      120\x0d\n    );\x0d\n    \x0d\n    // Play sound effect\x0d\n    AudioManager.playSe(soundConfig);\x0d\n    \x0d\n    // Set particle with target as picture ID\x0d\n    $gameScreen._particle.particleSet(\x0d\n      0\x2C \x0d\n      particleName\x2C \x0d\n      'picture:' + pictureId\x2C \x0d\n      'def'\x2C \x0d\n      'screen'\x0d\n    );\x0d\n  } else {\x0d\n    // Clear particle effect when disabling\x0d\n    $gameScreen._particle.particleClear(particleName);\x0d\n  }\x0d\n};\x0d\n\x0d\n//\u30d4\u30af\u30c1\u30e3\u306e\u52d5\u304d\u65b9\u8a2d\u5b9a\x0d\npicture_easingConfiguration = function (val1) {\x0d\n\x0d\n  $gameTemp._easingX = val1;\x0d\n  $gameTemp._easingY = val1;\x0d\n  $gameTemp._easingSx = val1;\x0d\n  $gameTemp._easingSy = val1;\x0d\n  $gameTemp._easingOp = val1;\x0d\n\x0d\n};\x0d\n\x0d\n//\u2606\u7acb\u3061\u7d75\u4f1a\u8a71\u6700\u521d\u306e\u8a2d\u5b9a\x0d\ntachie_kaiwastart = function (id1\x2C id2\x2C id3\x2C id4) {\x0d\n\x0d\n  $gameSwitches.setValue(127\x2C id1);//\u6025\u304etrue\u901a\u5e38false\x0d\n  $gameSwitches.setValue(126\x2C id2)//\u62e1\u5927true\u901a\u5e38false\x0d\n  $gameVariables.setValue(152\x2C id4);//\u53f3\u767b\u5834\u4eba\u6570\x0d\n  $gameVariables.setValue(153\x2C id3);//\u5de6\u767b\u5834\u4eba\u6570\x0d\n  $gameSwitches.setValue(5\x2C false);//\u30b9\u30ad\u30c3\u30d7on\u3002\u624b\u524d\u306e\u30b3\u30e2\u30f3\u3067\u30b9\u30a4\u30c3\u30c1on\u306b\u3057\u3066\u3044\u308b\u305f\u3081\x0d\n  $gameScreen.showPicture(5\x2C 'ScreenBlackOut'\x2C 1\x2C 640\x2C 384\x2C 100\x2C 100\x2C 25\x2C 0);\x0d\n  picture_fade1(5\x2C "fadeIn"\x2C valueWipeImg\x2C 60\x2C 5);\x0d\n\x0d\n\x0d\n};\x0d\n\x0d\n//\u2606\u7acb\u3061\u7d75\u4f1a\u8a71\u8863\u88c5\u7834\u640d\u8a2d\u5b9a//\uff71\uff78\uff80\uff70ID\x2C\u7834\u640d\u90e8\u4f4d\x2C\uff8b\uff9f\uff78ID\x2C1\u3067\u5168\u640d0\u3067\u7834\u640d\u3001101\u306f\u7834\u640dCG\u8868\u793a\uff8b\uff9f\uff78ID\u59cb\u70b9\x2Cid5\u304c1\u3067\u7834\u640d\u30010\u3067\u8131\u8863\x0d\ntachie_clothesHason = function (id1\x2C id2\x2C id3\x2C id4\x2C id5) {\x0d\n\x0d\n  $gameVariables.setValue(20\x2C id1);\x0d\n  clothes_hason1([id2]\x2C id4);\x0d\n  $gameSwitches.setValue(143\x2C false);\x0d\n  if ($gameVariables.value(244) >= 1) {\x0d\n    clothes_hason2(id3\x2C id5);\x0d\n    if (id5 == 1) {\x0d\n      $gameScreen.startFlash([255\x2C 255\x2C 255\x2C 170]\x2C 20);\x0d\n      AudioManager.playSe({ "name": "Collapse2"\x2C "volume": 50\x2C "pitch": 130\x2C "pan": 0 });\x0d\n      $gameScreen.shakePicture(id3\x2C 3\x2C 9\x2C 0\x2C 20);\x0d\n    }\x0d\n    else if (id5 == 0) {\x0d\n      AudioManager.playSe({ "name": "Z_ClothesTakeOff"\x2C "volume": 150\x2C "pitch": 110\x2C "pan": 0 });\x0d\n    }\x0d\n  }\x0d\n\x0d\n};\x0d\n\x0d\n//\u2606\u2606\u7acb\u3061\u7d75\u4f1a\u8a71\u52d5\u4f5c\u7528\x0d\nconst scaleConfigGeneral1TachieDousaMap = {\x0d\n  true: { scale: 70\x2C y: 650 }\x2C\x0d\n  false: { scale: 50\x2C y: 550 }\x0d\n};\x0d\nconst scaleConfigGeneral2TachieDousaMap = {\x0d\n  true: { scale: 200\x2C y: 700 }\x2C\x0d\n  false: { scale: 100\x2C y: 400 }\x0d\n};\x0d\nconst scaleConfigSSTachieDousaMap = {\x0d\n  true: { scale: 70\x2C y: 700 }\x2C\x0d\n  false: { scale: 50\x2C y: 550 }\x0d\n};\x0d\nconst actionItemIdsTachieDousa = [1\x2C 3\x2C 4\x2C 5];\x0d\ntachie_dousa = function (actionType\x2C actorParameter\x2C expressionCode\x2C targetPicId\x2C sourcePicId\x2C showCostumeId\x2C changeCostumeId\x2C changeCostumeParam\x2C unusedParam) {\x0d\n\x0d\n  // Set a temporary switch flag to indicate processing is underway\x0d\n  $gameSwitches.setValue(97\x2C true);\x0d\n\x0d\n  // Determine initial X offset based on the source picture ID\x0d\n  initialXOffset = sourcePicId == 0 ? 50 : -50;\x0d\n\x0d\n  // Set easing function and fade duration based on switch 127 (which may indicate a special mode)\x0d\n  const result1 = getEasingAndFadeValuesTachieDousa();\x0d\n  const easingFunction = result1.easingFunction;\x0d\n  const fadeDuration = result1.fadeDuration;\x0d\n\x0d\n  const result2 = calculateScaleAndPositionTachieDousa(actorParameter\x2C targetPicId\x2C expressionCode);\x0d\n  const picY = result2.picY;\x0d\n  const picScaleX = result2.picScaleX;\x0d\n  const picScaleY = result2.picScaleY;\x0d\n\x0d\n  // Replace the original selection placeholder code with:\x0d\n  const dollStateFlag = checkDollStateTachieDousa(actionType\x2C valueDollStateId);\x0d\n\x0d\n  // If not in doll state\x2C proceed with action-specific processing\x0d\n  if (dollStateFlag == 0) {\x0d\n    switch (actionType) {\x0d\n      case 0:\x0d\n        // --------- Action Type 0: Conversation picture change and costume update ----------\x0d\n        processCostumeChangeAnimationAtype0TachieDousa(actorParameter\x2C showCostumeId\x2C changeCostumeId\x2C changeCostumeParam\x2C targetPi